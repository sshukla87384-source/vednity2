# ---- Vednity website configuration ----
# Copy this file to ".env" and fill in your values.

# Port (Hostinger sets PORT automatically — leave as is)
PORT=3000
NODE_ENV=production

# SMTP — create a mailbox in hPanel > Emails, then use it here
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@yourdomain.com
SMTP_PASS=your-mailbox-password

# Where enquiries are delivered / the visible From address
CONTACT_TO=hello@yourdomain.com
SMTP_FROM=noreply@yourdomain.com

# Send an automatic "we got your message" email to the visitor (true/false)
AUTO_REPLY=true

# Set to false if your host already terminates HTTPS and redirects
FORCE_HTTPS=true

# Log each request to the runtime log (true/false)
LOG_REQUESTS=true

